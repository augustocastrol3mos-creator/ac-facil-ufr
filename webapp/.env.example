# Copie este arquivo para .env.local e preencha os valores.
# O .env.local NÃO vai para o Git (está no .gitignore).

# Senha do painel administrativo (/admin)
# Escolha uma senha forte. Sem esta variável o painel fica inacessível.
ADMIN_PASSWORD=

# Alerta persistente opcional exibido aos alunos (sobrevive a restarts do container).
# Formato JSON. Deixe vazio para gerenciar o alerta apenas pelo painel admin.
# Exemplo:
# UFR_ALERT={"enabled":true,"message":"Janela SEI aberta até 10/06.","type":"warning"}
UFR_ALERT=
